local ReplicatedStorage = game:GetService("ReplicatedStorage")
print("Hook starting...")

for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
    if v:IsA("RemoteEvent") then
        local old = hookfunction(v.FireServer, function(self, ...)
            print("[FIRE]", v:GetFullName(), ...)
            return old(self, ...)
        end)
    elseif v:IsA("RemoteFunction") then
        local old = hookfunction(v.InvokeServer, function(self, ...)
            print("[INVOKE]", v:GetFullName(), ...)
            return old(self, ...)
        end)
    end
end

print("Hook active. Open the Console. Put a brainrot in a trade.")
