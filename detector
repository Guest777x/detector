local Players = game:GetService("Players")
local PG = Players.LocalPlayer:WaitForChild("PlayerGui")

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "AutoOfferTest"
ScreenGui.Parent = PG

local Toggle = Instance.new("TextButton")
Toggle.Size = UDim2.new(0, 200, 0, 50)
Toggle.Position = UDim2.new(0, 20, 0, 20)
Toggle.BackgroundColor3 = Color3.new(0.8, 0.2, 0.2)
Toggle.Text = "AUTO-OFFER: OFF"
Toggle.TextColor3 = Color3.new(1,1,1)
Toggle.Font = Enum.Font.SourceSansBold
Toggle.TextSize = 20
Toggle.Parent = ScreenGui

local isOn = false
local targetItem = "Strawberrita" -- Searches for this text

Toggle.MouseButton1Click:Connect(function()
    isOn = not isOn
    Toggle.Text = isOn and "AUTO-OFFER: ON" or "AUTO-OFFER: OFF"
    Toggle.BackgroundColor3 = isOn and Color3.new(0.2, 0.8, 0.2) or Color3.new(0.8, 0.2, 0.2)
end)

local TradeRoot = PG:WaitForChild("TradeLiveTrade")
local TradeInner = TradeRoot:WaitForChild("TradeLiveTrade")
local MySide = TradeInner:WaitForChild("Your")
local ScrollingFrame = MySide:WaitForChild("ScrollingFrame")

ScrollingFrame.DescendantAdded:Connect(function(obj)
    if obj.Name == "Spacer" and isOn then
        task.wait(0.1) -- let it load
        local title = obj:FindFirstChild("Title", true)
        if title and string.find(string.lower(title.Text), string.lower(targetItem)) then
            print("Found target item: " .. title.Text .. ". Trying to auto-add...")
            
            -- Find the button connection and fire it
            if getconnections then
                local conns = getconnections(obj.MouseButton1Click)
                for _, c in pairs(conns) do
                    if c.Fire then
                        pcall(function()
                            c:Fire()
                            print("Fired connection successfully.")
                        end)
                    end
                end
            end
        end
    end
end)
