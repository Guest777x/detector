local RS = game:GetService("ReplicatedStorage")
local net = RS:FindFirstChild("Packages")
if not net then
    print("Packages not found yet. Wait a few seconds and rerun.")
    return
end

net = net:FindFirstChild("Net") or net

local count = 0
for _, v in ipairs(net:GetDescendants()) do
    if v:IsA("RemoteEvent") then
        local old = hookfunction(v.FireServer, function(self, ...)
            local name = v.Name
            if string.find(string.lower(name), "trade") or string.find(string.lower(name), "item") then
                print("[TRADE FIRE] " .. name, ...)
            end
            return old(self, ...)
        end)
        count = count + 1
    elseif v:IsA("RemoteFunction") then
        local old = hookfunction(v.InvokeServer, function(self, ...)
            local name = v.Name
            if string.find(string.lower(name), "trade") or string.find(string.lower(name), "item") then
                print("[TRADE INVOKE] " .. name, ...)
            end
            return old(self, ...)
        end)
        count = count + 1
    end
end
print("Hooked " .. count .. " trade-related remotes.")
