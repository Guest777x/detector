local PG = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
print("--- SCANNER STARTED ---")

-- Run continuously
task.spawn(function()
    while true do
        task.wait(1)
        local TradeRoot = PG:FindFirstChild("TradeLiveTrade")
        if TradeRoot then
            local TradeInner = TradeRoot:FindFirstChild("TradeLiveTrade") or TradeRoot
            local MySide = TradeInner:FindFirstChild("Your")
            local ScrollingFrame = MySide and MySide:FindFirstChild("ScrollingFrame")
            
            if ScrollingFrame then
                for _, obj in ipairs(ScrollingFrame:GetDescendants()) do
                    if obj.Name == "Spacer" then
                        local title = obj:FindFirstChild("Title", true)
                        -- Search for your item
                        if title and string.find(string.lower(title.Text), "strawberrita") then
                            print("FOUND: " .. title.Text .. " - Clicking it...")
                            if getconnections then
                                local conns = getconnections(obj.MouseButton1Click)
                                for _, c in pairs(conns) do
                                    if c.Fire then
                                        pcall(function() c:Fire() end)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)
